{
  "name": "creatorjobs-whop-takehome",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names client,server \"bun run dev:client\" \"bun run dev:server\"",
    "dev:client": "vite",
    "dev:server": "bun --watch server/index.ts",
    "build": "bun run typecheck && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "check": "bun run lint && bun run build",
    "preview": "vite preview",
    "start": "bun server/index.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.2.21",
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@hono/node-server": "^2.1.1",
    "@whop/sdk": "^0.0.42",
    "clsx": "^2.1.1",
    "hono": "^4.13.2",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.5",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
